    "LSTM_units":25, 
    "3D_depth":5,
    "latent_dim":2,
    "optuna_optimization": true,
    "n_trials": 20,
    "optuna_parameters": {
        "sampler_algorithm": ["tpe"],
        "loss_weight_1": ["grid", [1, 2, 4, 6, 8, 10]],
        "loss_weight_2":  ["grid", [2, 4, 6, 8, 10]],
        "3D_depth": ["grid", [2,3,5,8,10]],
        "l2_reg": ["grid", [0.1, 0.001, 0.0001]],
        "LSTM_units": ["grid", [5, 10, 20, 25, 40]]
  
    }
