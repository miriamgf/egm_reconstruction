/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 500
  /ImageMatrix [291 0 0 500 0 0]
  /Width 291
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
