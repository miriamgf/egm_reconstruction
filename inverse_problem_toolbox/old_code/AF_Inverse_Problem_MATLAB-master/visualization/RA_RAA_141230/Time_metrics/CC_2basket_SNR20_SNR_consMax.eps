<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 400
  /ImageMatrix [523 0 0 400 0 0]
  /Width 523
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
