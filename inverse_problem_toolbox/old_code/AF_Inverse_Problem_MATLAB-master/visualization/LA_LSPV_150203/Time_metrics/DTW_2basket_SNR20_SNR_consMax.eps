/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 125
  /ImageMatrix [1162 0 0 125 0 0]
  /Width 1162
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
